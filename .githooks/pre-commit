#!/usr/bin/env bash
set -euo pipefail

# Fast local pre-commit check: runs only when Go source files are staged.
staged_go_files=()
while IFS= read -r -d '' file; do
  if [ -n "$file" ]; then
    staged_go_files+=("$file")
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.go')

if [ "${#staged_go_files[@]}" -eq 0 ]; then
  exit 0
fi

unformatted="$(gofmt -l "${staged_go_files[@]}")"
if [ -n "$unformatted" ]; then
  echo "pre-commit: unformatted Go files detected. Run 'gofmt -w' on:" >&2
  printf '  %s\n' "$unformatted" >&2
  exit 1
fi

go vet ./...
go tool mygo vet .
